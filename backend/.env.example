# ── Database ────────────────────────────────────────────────────────────────
# MongoDB connection URI. Never commit a URI that contains real credentials.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/atlaswatch?retryWrites=true&w=majority"

PORT=3000

# ── Secrets (required in production) ────────────────────────────────────────
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET signs user session tokens; rotating it signs everyone out.
JWT_SECRET=
# ADMIN_API_KEY guards /admin/*, /sos/alerts and geofence management.
# The operations dashboard asks for this value; it is not a user password.
ADMIN_API_KEY=

# Optional: how long a session token stays valid (default 30d).
JWT_TTL=30d

# ── Browser clients ─────────────────────────────────────────────────────────
# Comma-separated origin allowlist for the dashboard.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Data retention ──────────────────────────────────────────────────────────
# Days of raw GPS breadcrumbs to keep (TTL index). Default 7.
LOCATION_RETENTION_DAYS=7

# Max document upload size in bytes (default 10 MB).
UPLOAD_MAX_BYTES=10485760

# ── Outbound SOS notifications (optional) ───────────────────────────────────
# Without these the backend records SOS alerts and logs the intended
# recipients, but no SMS is sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
